! Source: Supplied HIBO_Task1_Standard_Ground(1).idf; HIBO ITSG Opaque Panel 1in Eq
! Source: Supplied HIBO_Task1_Standard_Ground(1).idf; HIBO ITSG Opaque Panel 1in Eq
Material,
    HIBO ITSG Opaque Panel 1in Eq,  !- Name
    Smooth,                  !- Roughness
    0.0254,                  !- Thickness {m}
    0.0607313642757,         !- Conductivity {W/m-K}
    400,                     !- Density {kg/m3}
    840,                     !- Specific Heat {J/kg-K}
    0.84,                    !- Thermal Absorptance
    0.6,                     !- Solar Absorptance
    0.6;                     !- Visible Absorptance

! Material reference: HIBO Carpet Tile CPT-1 Eq
! Scope: Product-specific nominal thickness; generic carpet thermal tuple. Derived areal mass1.50kg/m2 lies within manufacturer nominal4.5–5.2oz/ft2 range.
! Source: EnergyPlus v22.2.0 ASHRAE_2005_HOF_Materials.idf, F17 Carpet; Generic carpet roughness category
! URL: https://github.com/NatLabRockies/EnergyPlus/blob/v22.2.0/datasets/ASHRAE_2005_HOF_Materials.idf
! Source: J+J Flooring, Kinetex Against the Grain Demi-Plank 1840, Product Specs; A1.1 finish schedule identifies1840; 0.205in=5.207mm
! URL: https://www.jjflooringgroup.com/product/against-the-grain-demi-plank/
! Source: EnergyPlus v22.2.0 ASHRAE_2005_HOF_Materials.idf, F17 Carpet; Generic carpet reference .06/288/1380; reference t.0127m adapted to5.207mm
! URL: https://github.com/NatLabRockies/EnergyPlus/blob/v22.2.0/datasets/ASHRAE_2005_HOF_Materials.idf
! Source: EnergyPlus v22.2.0 ASHRAE_2005_HOF_Materials.idf, F17 Carpet; Generic carpet reference .06/288/1380; reference t.0127m adapted to5.207mm
! URL: https://github.com/NatLabRockies/EnergyPlus/blob/v22.2.0/datasets/ASHRAE_2005_HOF_Materials.idf
! Source: EnergyPlus v22.2.0 ASHRAE_2005_HOF_Materials.idf, F17 Carpet; Generic carpet reference .06/288/1380; reference t.0127m adapted to5.207mm
! URL: https://github.com/NatLabRockies/EnergyPlus/blob/v22.2.0/datasets/ASHRAE_2005_HOF_Materials.idf
! Source: EnergyPlus v22.2.0 Input Output Reference, Material defaults; Documented defaults .9/.7/.7; not measured Kinetex surface properties
! URL: https://github.com/NatLabRockies/EnergyPlus/blob/v22.2.0/doc/input-output-reference/src/overview/group-surface-construction-elements.tex#L87-L97
! Source: EnergyPlus v22.2.0 Input Output Reference, Material defaults; Documented defaults .9/.7/.7; not measured Kinetex surface properties
! URL: https://github.com/NatLabRockies/EnergyPlus/blob/v22.2.0/doc/input-output-reference/src/overview/group-surface-construction-elements.tex#L87-L97
! Source: EnergyPlus v22.2.0 Input Output Reference, Material defaults; Documented defaults .9/.7/.7; not measured Kinetex surface properties
! URL: https://github.com/NatLabRockies/EnergyPlus/blob/v22.2.0/doc/input-output-reference/src/overview/group-surface-construction-elements.tex#L87-L97
Material,
    HIBO Carpet Tile CPT-1 Eq,  !- Name
    MediumRough,             !- Roughness
    0.005207,                !- Thickness {m}
    0.06,                    !- Conductivity {W/m-K}
    288,                     !- Density {kg/m3}
    1380,                    !- Specific Heat {J/kg-K}
    0.9,                     !- Thermal Absorptance
    0.7,                     !- Solar Absorptance
    0.7;                     !- Visible Absorptance


!-   ===========  ALL OBJECTS IN CLASS: MATERIAL:NOMASS ===========

! Source: Supplied HIBO_Task1_Standard_Ground(1).idf, HIBO Air Barrier Eq
Material:NoMass,
    HIBO Air Barrier Eq,     !- Name
    MediumSmooth,            !- Roughness
    0.001,                   !- Thermal Resistance {m2-K/W}
    0.90,                    !- Thermal Absorptance
    0.50,                    !- Solar Absorptance
    0.50;                    !- Visible Absorptance

! Source: Supplied HIBO_Task1_Standard_Ground(1).idf, HIBO Roof Vapor Retarder Eq
Material:NoMass,
    HIBO Roof Vapor Retarder Eq,  !- Name
    Smooth,                  !- Roughness
    0.0010,                  !- Thermal Resistance {m2-K/W}
    0.90,                    !- Thermal Absorptance
    0.50,                    !- Solar Absorptance
    0.50;                    !- Visible Absorptance


!-   ===========  ALL OBJECTS IN CLASS: MATERIAL:AIRGAP ===========

! Source: EnergyPlus v22.2.0, ASHRAE_2005_HOF_Materials.idf, Material:AirGap F04 Wall air space resistance
! URL: https://github.com/NatLabRockies/EnergyPlus/blob/v22.2.0/datasets/ASHRAE_2005_HOF_Materials.idf#L475-L477
Material:AirGap,
    HIBO Exterior Drainage Cavity,  !- Name
    0.15;                    !- Thermal Resistance {m2-K/W}


!-   ===========  ALL OBJECTS IN CLASS: WINDOWMATERIAL:SIMPLEGLAZINGSYSTEM ===========

WindowMaterial:SimpleGlazingSystem,
    SN54_1in_IGU,            !- Name
    1.36,                    !- U-Factor {W/m2-K}
    0.28,                    !- Solar Heat Gain Coefficient
    0.54;                    !- Visible Transmittance


!-   ===========  ALL OBJECTS IN CLASS: WINDOWMATERIAL:GLAZING ===========

WindowMaterial:Glazing,
    HIBO Interior CTG 1-4in, !- Name
    SpectralAverage,         !- Optical Data Type
    ,                        !- Window Glass Spectral Data Set Name
    0.00635,                 !- Thickness {m}
    0.775,                   !- Solar Transmittance at Normal Incidence
    0.071,                   !- Front Side Solar Reflectance at Normal Incidence
    0.071,                   !- Back Side Solar Reflectance at Normal Incidence
    0.881,                   !- Visible Transmittance at Normal Incidence
    0.08,                    !- Front Side Visible Reflectance at Normal Incidence
    0.08,                    !- Back Side Visible Reflectance at Normal Incidence
    0,                       !- Infrared Transmittance at Normal Incidence
    0.84,                    !- Front Side Infrared Hemispherical Emissivity
    0.84,                    !- Back Side Infrared Hemispherical Emissivity
    0.9,                     !- Conductivity {W/m-K}
    1,                       !- Dirt Correction Factor for Solar and Visible Transmittance
    No;                      !- Solar Diffusing


